# Copy to .env.local for local overrides (git-ignored via *.local).
# NEVER commit a real ngrok URL — it changes on every ngrok restart.
# After changing this file, restart the Vite dev server (env is baked at startup).
#
# SINGLE-TUNNEL SETUP (recommended): one ngrok tunnel on the Vite server.
# Leave everything below UNSET. The browser uses same-origin URLs and Vite
# proxies /api and /ws to the FastAPI backend:
#   page → https://YOUR-TUNNEL.ngrok-free.dev/...
#   API  → https://YOUR-TUNNEL.ngrok-free.dev/api/... → http://127.0.0.1:8000/api/...
#   WS   → wss://YOUR-TUNNEL.ngrok-free.dev/ws/...  → ws://127.0.0.1:8000/ws/...
# QR codes automatically use the tunnel origin you opened the page with.

# SPLIT SETUP (only if frontend and backend have separate public URLs):
# Local default: leave empty/unset.
# VITE_API_URL=

# Remote split test (backend exposed via its own ngrok tunnel). Same value drives BOTH:
#   HTTP API -> https://YOUR-NGROK-DOMAIN.ngrok-free.app/api/...
#   WebSocket -> wss://YOUR-NGROK-DOMAIN.ngrok-free.app/ws/...
# VITE_API_URL=https://YOUR-NGROK-DOMAIN.ngrok-free.app

# Rarely needed: force only the signaling socket elsewhere.
# VITE_WS_URL=wss://YOUR-NGROK-DOMAIN.ngrok-free.app
