# Copy to .env for local runs (backend reads these at startup).
# Frontend uses VITE_ variables instead; see frontend docs.

# Whisper model: tiny | base | small (default) — small is multilingual-capable
# but transcription below is forced to English for the MVP.
WHISPER_MODEL=small
# Transcription language: English-only MVP (always "en").
WHISPER_LANGUAGE=en
# Compute: auto | cpu | cuda
WHISPER_DEVICE=auto
# Precision: auto | int8 | float16 | float32
WHISPER_COMPUTE_TYPE=auto
