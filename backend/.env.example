# Copy to backend/.env for local runs (loaded via python-dotenv).
# NEVER commit real URLs or secrets.

# Public HTTPS frontend whose origin may call the API (comma-separated).
# Localhost dev origins are always allowed; add the deployed frontend here.
# CORS_ORIGINS=https://my-frontend.vercel.app

# Public frontend URL baked into QR/invitation links, so phones opening a
# scanned code reach the public frontend instead of localhost.
# FRONTEND_URL=https://my-frontend.vercel.app

# Whisper model: tiny | base | small (default) — transcription forced English.
WHISPER_MODEL=small
# Transcription language: English-only MVP (always "en").
WHISPER_LANGUAGE=en
# Compute: auto | cpu | cuda
WHISPER_DEVICE=auto
# Precision: auto | int8 | float16 | float32
WHISPER_COMPUTE_TYPE=auto
